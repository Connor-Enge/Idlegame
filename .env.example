# Neon Postgres connection string (pooled). Get this from the Neon dashboard
# or from the Vercel integration (Storage -> Neon). Example:
# postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Optional: a non-pooled direct connection used by drizzle-kit migrations.
# postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=

# Secret used to sign account session cookies. Set a long random string in
# production (e.g. `openssl rand -base64 32`). A dev fallback is used if unset,
# which is NOT secure for real accounts.
AUTH_SECRET=
